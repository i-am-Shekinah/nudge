# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database (Neon PostgreSQL)
# Get your connection string from: https://neon.tech
# Use the pooled connection string for production
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/nudge?sslmode=require

# ─────────────────────────────────────────────
# Auth / Encryption
# JWT_SECRET: random 64-char string — generate with: openssl rand -hex 64
# ENCRYPTION_KEY: exactly 64 hex characters (32 bytes) — generate with: openssl rand -hex 32
# ─────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/auth/google/callback
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─────────────────────────────────────────────
# Gemini AI
# Get your API key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.75

# ─────────────────────────────────────────────
# Redis (Upstash)
# Get your Redis URL at: https://upstash.com
# Use the TLS URL (starts with rediss://)
# ─────────────────────────────────────────────
REDIS_URL=rediss://default:password@host:port

# ─────────────────────────────────────────────
# Email (Resend)
# Get your API key at: https://resend.com
# RESEND_FROM_EMAIL must be from a verified domain
# ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=nudge@yourdomain.com

# ─────────────────────────────────────────────
# Web Push (VAPID)
# Generate keys with: node -e "const wp = require('web-push'); console.log(wp.generateVAPIDKeys())"
# VAPID_SUBJECT must be a mailto: address
# ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
