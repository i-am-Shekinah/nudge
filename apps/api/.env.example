# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database
# Local dev uses a local PostgreSQL 16 instance (no sslmode needed); prefer the
# explicit IPv4 address over `localhost` so DNS can't hand back "::1" first:
#   postgresql://nudge:<password>@127.0.0.1:5432/nudge
# See docs/DEVELOPER_GUIDE.md for the role/DB creation commands.
# Neon remains the production provider — use the pooled connection string there.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://nudge:password@127.0.0.1:5432/nudge
# Neon (production): postgresql://user:password@host/nudge?sslmode=require

# ─────────────────────────────────────────────
# Auth / Encryption
# JWT_SECRET: random 64-char string — generate with: openssl rand -hex 64
# ENCRYPTION_KEY: exactly 64 hex characters (32 bytes) — generate with: openssl rand -hex 32
# ─────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/auth/google/callback
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─────────────────────────────────────────────
# Gemini AI
# Get your API key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=
# Model retired by Google without notice (2.0 Flash died 2026-10-11); keep swappable
GEMINI_MODEL=gemini-3.8-flash
# Emails per Gemini call (free tier: 20 calls/day). Range 1-30.
AI_BATCH_SIZE=20
AI_CONFIDENCE_THRESHOLD=0.75

# ─────────────────────────────────────────────
# Redis (Upstash)
# Get your Redis URL at: https://upstash.com
# Use the TLS URL (starts with rediss://)
# ─────────────────────────────────────────────
REDIS_URL=rediss://default:password@host:port

# ─────────────────────────────────────────────
# Email (Resend)
# Get your API key at: https://resend.com
# RESEND_FROM_EMAIL must be from a verified domain
# ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=nudge@yourdomain.com

# ─────────────────────────────────────────────
# Web Push (VAPID)
# Generate keys with: node -e "const wp = require('web-push'); console.log(wp.generateVAPIDKeys())"
# VAPID_SUBJECT must be a mailto: address
# ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
